# DeepSeek 文案生成服务
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 默认中文配音声音
TTS_VOICE=zh-CN-XiaoxiaoNeural

# 允许访问后端的前端地址，多个地址用英文逗号分隔
# 本地开发示例：http://localhost:3000
# 公网部署时必须改成真实前端 HTTPS 域名，例如：https://video.example.com
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 生产环境建议使用持久化磁盘路径；相对路径相对于 backend 目录
STORAGE_DIR=storage
DATABASE_PATH=app.db
